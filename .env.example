# Runtime mode
USE_REAL_BLE_DATA=0
REPLAY_RECORDED_DATA=0
ENABLE_CONTROL_LOOP=1
VISUALIZATION_MODE=shm
OUTPUT_ROOT=outputs
LOG_OUTPUT_DIR=outputs/logs
VIS_OUTPUT_DIR=outputs/visualization
DATA_OUTPUT_DIR=outputs/data

# BLE device
BLE_DEVICE_ADDRESS=
BLE_NOTIFY_CHAR=0000ffe1-0000-1000-8000-00805f9b34fb
BLE_WRITE_CHAR=0000ffe1-0000-1000-8000-00805f9b34fb
BLE_ADAPTER_ID=
BLE_CONNECT_TIMEOUT=8.0
BLE_RECONNECT_DELAY=3.0

# Replay mode
RECORDED_LASER_LOG=outputs/logs/ble_parsed.log
RECORDED_TICKS_PER_METER=1910.0

# Motion / calibration
LIDAR_ANGLE_OFFSET_DEG=0.0
ANGLE_CORRECTION_FACTOR=0.0
BLE_TICKS_PER_METER=1910.0

# Optional tuning
CONTROL_STARTUP_DELAY=2.0
BLE_MOTOR_SPEED_SCALE=0.18
